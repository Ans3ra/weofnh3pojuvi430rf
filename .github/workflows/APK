name: Build APK

# Everything the Android build needs is embedded in this one file, so the repo
# only ever holds your web files. Nothing to unpack, no nested folders to make.
#
# Run "Make Keystore" once before the first build, or the apk comes out
# unsigned and Android will refuse to install it.
on:
  push:
    branches: [ main ]
    paths:
      - "index.html"
      - "sw.js"
      - "manifest.json"
      - "icon-*.png"
      - ".github/workflows/build-apk.yml"
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Check the web files are present
        run: |
          missing=0
          for f in index.html manifest.json icon-192.png icon-512.png; do
            if [ ! -f "$f" ]; then echo "::error::$f is not at the repo root"; missing=1; fi
          done
          [ $missing -eq 0 ] || exit 1
          echo "all web files found"

      - name: Write the Android project
        run: |
          mkdir -p android/app
          echo  | base64 -d > android/app/build.gradle
          mkdir -p android/app/src/main
          echo  | base64 -d > android/app/src/main/AndroidManifest.xml
          mkdir -p android/app/src/main/java/app/hub/sched
          echo  | base64 -d > android/app/src/main/java/app/hub/sched/MainActivity.java
          mkdir -p android/app/src/main/res/values
          echo PD94bWwgdmVyc2lvbj0iMS4wIiBlbmNvZGluZz0idXRmLTgiPz4KPHJlc291cmNlcz4KICAgIDxzdHJpbmcgbmFtZT0iYXBwX25hbWUiPlNDSEVEVUxFPC9zdHJpbmc+CjwvcmVzb3VyY2VzPgo= | base64 -d > android/app/src/main/res/values/strings.xml
          mkdir -p android/app/src/main/res/values
          echo  | base64 -d > android/app/src/main/res/values/themes.xml
          mkdir -p android/app/src/main/res/xml
          echo PD94bWwgdmVyc2lvbj0iMS4wIiBlbmNvZGluZz0idXRmLTgiPz4KPGZ1bGwtYmFja3VwLWNvbnRlbnQ+CiAgICA8aW5jbHVkZSBkb21haW49ImRhdGFiYXNlIiBwYXRoPSIuIiAvPgogICAgPGluY2x1ZGUgZG9tYWluPSJmaWxlIiBwYXRoPSJhcHBfd2Vidmlldy8iIC8+CjwvZnVsbC1iYWNrdXAtY29udGVudD4K | base64 -d > android/app/src/main/res/xml/backup_rules.xml
          mkdir -p android/app/src/main/res/xml
          echo  | base64 -d > android/app/src/main/res/xml/data_rules.xml
          mkdir -p android/app/src/main/res/xml
          echo PD94bWwgdmVyc2lvbj0iMS4wIiBlbmNvZGluZz0idXRmLTgiPz4KPHBhdGhzPgogICAgPGNhY2hlLXBhdGggbmFtZT0ic2hhcmVkIiBwYXRoPSJzaGFyZWQvIiAvPgo8L3BhdGhzPgo= | base64 -d > android/app/src/main/res/xml/file_paths.xml
          mkdir -p android
          echo cGx1Z2lucyB7CiAgICBpZCAiY29tLmFuZHJvaWQuYXBwbGljYXRpb24iIHZlcnNpb24gIjguNS4yIiBhcHBseSBmYWxzZQp9Cg== | base64 -d > android/build.gradle
          mkdir -p android
          echo b3JnLmdyYWRsZS5qdm1hcmdzPS1YbXgyMDQ4bSAtRGZpbGUuZW5jb2Rpbmc9VVRGLTgKYW5kcm9pZC51c2VBbmRyb2lkWD10cnVlCmFuZHJvaWQubm9uVHJhbnNpdGl2ZVJDbGFzcz10cnVlCg== | base64 -d > android/gradle.properties
          mkdir -p android/gradle/wrapper
          echo ZGlzdHJpYnV0aW9uQmFzZT1HUkFETEVfVVNFUl9IT01FCmRpc3RyaWJ1dGlvblBhdGg9d3JhcHBlci9kaXN0cwpkaXN0cmlidXRpb25Vcmw9aHR0cHNcOi8vc2VydmljZXMuZ3JhZGxlLm9yZy9kaXN0cmlidXRpb25zL2dyYWRsZS04LjktYmluLnppcAp6aXBTdG9yZUJhc2U9R1JBRExFX1VTRVJfSE9NRQp6aXBTdG9yZVBhdGg9d3JhcHBlci9kaXN0cwo= | base64 -d > android/gradle/wrapper/gradle-wrapper.properties
          mkdir -p android
          echo  | base64 -d > android/settings.gradle
          echo "project written"

      - name: Bundle the web app into the apk
        run: |
          mkdir -p android/app/src/main/assets
          cp index.html manifest.json icon-192.png icon-512.png android/app/src/main/assets/
          if [ -f sw.js ]; then cp sw.js android/app/src/main/assets/; fi
          ls -la android/app/src/main/assets

      - name: Launcher icons
        run: |
          sudo apt-get update -qq && sudo apt-get install -y -qq imagemagick
          for d in mdpi:48 hdpi:72 xhdpi:96 xxhdpi:144 xxxhdpi:192; do
            n="${d%%:*}"; px="${d##*:}"
            mkdir -p "android/app/src/main/res/mipmap-$n"
            convert icon-512.png -resize ${px}x${px} "android/app/src/main/res/mipmap-$n/ic_launcher.png"
          done

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - uses: android-actions/setup-android@v3

      - name: Restore signing key
        id: keystore
        env:
          KEYSTORE_B64: ${{ secrets.KEYSTORE_B64 }}
        run: |
          if [ -z "$KEYSTORE_B64" ]; then
            echo "have_key=no" >> $GITHUB_OUTPUT
            echo "::warning::No KEYSTORE_B64 secret - the apk will be unsigned and will not install. Run Make Keystore first."
          else
            echo "$KEYSTORE_B64" | base64 -d > $RUNNER_TEMP/release.jks
            echo "have_key=yes" >> $GITHUB_OUTPUT
          fi

      - name: Build
        working-directory: android
        env:
          KEYSTORE_PATH: ${{ steps.keystore.outputs.have_key == 'yes' && format('{0}/release.jks', runner.temp) || '' }}
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: |
          gradle wrapper --gradle-version 8.9
          ./gradlew assembleRelease --no-daemon -Pvcode=${{ github.run_number }} -Pvname=1.${{ github.run_number }}

      - name: Collect
        id: apk
        run: |
          f=$(find android/app/build/outputs/apk/release -name "*.apk" | head -1)
          if [ -z "$f" ]; then echo "::error::no apk was produced"; exit 1; fi
          cp "$f" schedule-hub.apk
          echo "size=$(du -h schedule-hub.apk | cut -f1)" >> $GITHUB_OUTPUT

      - uses: actions/upload-artifact@v4
        with:
          name: schedule-hub-apk
          path: schedule-hub.apk
          retention-days: 90

      - name: Publish release
        if: steps.keystore.outputs.have_key == 'yes'
        uses: softprops/action-gh-release@v2
        with:
          tag_name: v1.${{ github.run_number }}
          name: SCHEDULE 1.${{ github.run_number }}
          body: |
            Built from index.html at ${{ github.sha }} - ${{ steps.apk.outputs.size }}.
            Tap the .apk file below on your phone to install.
          files: schedule-hub.apk
