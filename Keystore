name: Make Keystore

# Run this ONCE, by hand, before the first real build.
# It creates a signing key and prints the three values to paste into
# Settings -> Secrets and variables -> Actions.
#
# The same key must be used for every future build: Android refuses to
# update an installed app if the signature changes. Keep the artifact.
on:
  workflow_dispatch:
    inputs:
      alias:
        description: "Key alias"
        default: "schedule"
        required: true

jobs:
  keystore:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Generate
        run: |
          PASS=$(head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 24)
          keytool -genkeypair -v \
            -keystore release.jks \
            -alias "${{ inputs.alias }}" \
            -keyalg RSA -keysize 4096 -validity 10000 \
            -storepass "$PASS" -keypass "$PASS" \
            -dname "CN=SCHEDULE, OU=Personal, O=Personal, L=, S=, C=US"
          {
            echo "## Add these three repository secrets"
            echo ""
            echo "Settings → Secrets and variables → Actions → New repository secret"
            echo ""
            echo '| Secret | Value |'
            echo '|---|---|'
            echo "| \`KEY_ALIAS\` | \`${{ inputs.alias }}\` |"
            echo "| \`KEYSTORE_PASSWORD\` | \`$PASS\` |"
            echo "| \`KEY_PASSWORD\` | \`$PASS\` |"
            echo ""
            echo "Then download the **keystore** artifact below, base64 it, and add that as \`KEYSTORE_B64\`:"
            echo ""
            echo '```'
            echo 'base64 -w0 release.jks   # macOS: base64 -i release.jks'
            echo '```'
            echo ""
            echo "Or copy the ready-made value from the \`KEYSTORE_B64.txt\` file in the artifact."
            echo ""
            echo "> Keep the artifact. Losing this key means you can never update an installed app in place."
          } >> $GITHUB_STEP_SUMMARY
          base64 -w0 release.jks > KEYSTORE_B64.txt

      - uses: actions/upload-artifact@v4
        with:
          name: keystore
          path: |
            release.jks
            KEYSTORE_B64.txt
          retention-days: 7
